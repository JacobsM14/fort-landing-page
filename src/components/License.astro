---
import licenseText from "../license.txt?raw";
import { useTranslations } from "../i18n/utils";
import { links } from "../links";

const t = useTranslations(Astro.currentLocale);

const email = links.contact.replace("mailto:", "");

// The legal text stays in its original wording; its hard line breaks are only for the plain-text file.
const paragraphs = licenseText
  .trim()
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.replace(/\s*\n\s*/g, " "));
---

<main class="mx-auto w-full max-w-page px-12 py-16 md:py-24">
  <article class="mx-auto flex max-w-2xl flex-col gap-14">
    <header class="flex flex-col gap-8">
      <h1 class="text-4xl leading-tight font-bold text-text md:text-5xl">
        {t("license.title")}
      </h1>
      <p class="text-[19px] text-disabled">{t("license.intro")}</p>
    </header>

    <section class="flex flex-col gap-4 text-[17px] leading-relaxed text-disabled">
      <h2 class="font-mono text-[13px] tracking-[1px] text-accent uppercase">
        {t("license.summary.title")}
      </h2>
      <p>{t("license.summary.text")}</p>
      <p class="text-sm">{t("license.summary.note")}</p>
    </section>

    <section class="flex flex-col gap-4 text-[17px] leading-relaxed text-disabled">
      <h2 class="font-mono text-[13px] tracking-[1px] text-accent uppercase">
        {t("license.text.title")}
      </h2>
      <p>{t("license.text.intro")}</p>
      <div
        lang="en"
        class="flex flex-col gap-4 rounded border border-border/40 bg-bg-dark-secondary p-6 font-mono text-sm leading-relaxed"
      >
        {
          paragraphs.map((paragraph) => {
            const [before, after] = paragraph.split(email);
            return after === undefined ? (
              <p>{paragraph}</p>
            ) : (
              <p>
                {before}
                <a
                  href={links.contact}
                  class="text-accent underline-offset-4 hover:underline"
                >
                  {email}
                </a>
                {after}
              </p>
            );
          })
        }
      </div>
      {
        links.repo && (
          <a
            href={links.repo}
            class="self-start text-sm text-accent underline-offset-4 hover:underline"
          >
            {t("license.viewRepo")}
          </a>
        )
      }
    </section>
  </article>
</main>
