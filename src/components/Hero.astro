---
import { Image } from "astro:assets";
import enWorkout from "../assets/screenshots/en/workout.webp";
import esWorkout from "../assets/screenshots/es/workout.webp";
import { getLang, useTranslations, type Lang } from "../i18n/utils";
import DownloadButton from "./DownloadButton.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const screenshots: Record<Lang, ImageMetadata> = {
  en: enWorkout,
  es: esWorkout,
};

const corners = [
  "top-0 left-0 border-t-2 border-l-2",
  "top-0 right-0 border-t-2 border-r-2",
  "bottom-0 left-0 border-b-2 border-l-2",
  "bottom-0 right-0 border-b-2 border-r-2",
];
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="scroll-mt-32 grid items-center gap-12 pt-2 pb-16 md:grid-cols-[1fr_auto] md:py-16"
>
  <div class="flex flex-col gap-7 max-w-2xl">
    <p class="font-mono text-[13px] tracking-[1px] text-accent uppercase">
      {t("hero.eyebrow")}
    </p>
    <h1
      id="hero-title"
      class="text-5xl leading-[1.05] text-text md:text-6xl lg:text-[84px] font-bold"
    >
      {t("hero.title")}
    </h1>
    <p class="max-w-xl text-[19px] text-disabled">
      {t("hero.description")}
    </p>
    <DownloadButton class="md:self-start" />
  </div>

  <div class="glow mx-auto">
    {
      corners.map((position) => (
        <span
          aria-hidden="true"
          class:list={["absolute size-6 border-accent", position]}
        />
      ))
    }
    <Image
      class="w-56 bg-bg-dark py-4 sm:w-[290px]"
      src={screenshots[lang]}
      alt={t("hero.screenshotAlt")}
      width={290}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
