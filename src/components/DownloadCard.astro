---
import { Image } from "astro:assets";
import enProgress from "../assets/screenshots/en/progress.webp";
import esProgress from "../assets/screenshots/es/progress.webp";
import { getLang, useTranslations, type Lang } from "../i18n/utils";
import DownloadButton from "./DownloadButton.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const screenshots: Record<Lang, ImageMetadata> = {
  en: enProgress,
  es: esProgress,
};
---

<section
  id="download"
  aria-labelledby="download-title"
  class="scroll-mt-32 relative mx-auto mt-8 grid w-full max-w-4xl items-center gap-10 overflow-hidden px-6 py-10 text-center md:mt-12 md:grid-cols-[1fr_auto] md:px-14 md:py-12 md:text-left"
>
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 size-full text-border"
  >
    <rect
      width="100%"
      height="100%"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-dasharray="27 16"></rect>
  </svg>

  <div class="flex flex-col items-center gap-5 md:items-start md:gap-6">
    <p class="font-mono text-[13px] tracking-[1px] text-accent uppercase">
      {t("download.eyebrow")}
    </p>
    <h2
      id="download-title"
      class="text-3xl leading-tight font-bold text-text sm:text-4xl md:text-5xl"
    >
      {t("download.title")}
    </h2>
    <p class="max-w-md text-[17px] text-disabled md:text-[19px]">
      {t("download.description")}
    </p>
    <DownloadButton class="mt-2" />
  </div>

  <div class="mx-auto w-44 hidden md:w-56 md:block">
    <Image
      src={screenshots[lang]}
      alt={t("download.screenshotAlt")}
      width={224}
      densities={[1, 2]}
      class="block w-full drop-shadow-2xl"
    />
  </div>
</section>
