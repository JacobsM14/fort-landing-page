---
import { useTranslations, type UIKey } from "../../i18n/utils";

interface Props {
  title: UIKey;
  description: UIKey;
  highlight?: boolean;
  compact?: boolean;
  class?: string;
}

const { title, description, highlight, compact, class: className } =
  Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<li
  class:list={[
    "flex flex-col justify-between gap-4 rounded border bg-bg-dark-secondary p-6 fade-in-on-scroll",
    highlight ? "border-accent/60" : "border-border/40",
    compact && "max-md:flex-row max-md:items-center max-md:justify-start max-md:gap-5",
    className,
  ]}
>
  <div aria-hidden="true" class:list={[compact && "max-md:w-30 max-md:shrink-0"]}>
    <slot />
  </div>
  <div class="flex flex-col gap-1.5">
    <h3 class="text-lg font-bold text-text">{t(title)}</h3>
    <p class="text-sm text-disabled">{t(description)}</p>
  </div>
</li>
