---
import { getRelativeLocaleUrl } from "astro:i18n";
import logo from "../assets/logo.svg";
import { defaultLang, useTranslations, type UIKey } from "../i18n/utils";
import { authorName, links } from "../links";

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);

const groups: { title: UIKey; items: { label: UIKey; href: string }[] }[] = [
  {
    title: "footer.project",
    items: [
      { label: "footer.sourceCode", href: links.repo },
      { label: "footer.license", href: links.license },
      { label: "footer.privacy", href: links.privacy },
    ],
  },
  {
    title: "footer.author",
    items: [
      { label: "footer.portfolio", href: links.portfolio },
      { label: "footer.github", href: links.github },
      { label: "footer.linkedin", href: links.linkedin },
      { label: "footer.contact", href: links.contact },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border/40 bg-bg-dark-secondary">
  <div
    class="mx-auto flex w-full max-w-page flex-col gap-12 px-12 py-12 md:flex-row md:justify-between"
  >
    <div class="flex flex-col gap-4">
      <a href={getRelativeLocaleUrl(lang)} class="flex items-center gap-3">
        <img
          src={logo.src}
          alt=""
          width="32"
          height="32"
          loading="lazy"
          class="size-8"
        />
        <span class="flex flex-col leading-tight">
          <span class="text-xl font-bold text-text">{t("app.name")}</span>
          <span class="font-mono text-xs text-accent">{t("app.tagline")}</span>
        </span>
      </a>
      <p class="font-mono text-[13px] text-disabled">
        © {year} {t("app.name")}
        {authorName && ` · ${t("footer.madeBy")} ${authorName}`}
      </p>
    </div>

    <nav aria-label={t("footer.label")} class="grid grid-cols-2 gap-12 md:gap-20">
      {
        groups.map(({ title, items }) => (
          <div class="flex flex-col gap-4">
            <h2 class="font-mono text-[13px] tracking-[1px] text-disabled uppercase">
              {t(title)}
            </h2>
            <ul class="flex flex-col gap-3">
              {items.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-sm text-text transition-colors hover:text-accent"
                  >
                    {t(label)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</footer>
