---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getLang,
  languages,
  pathWithoutLocale,
  useTranslations,
} from "../../i18n/utils";

const current = getLang(Astro.currentLocale);
const t = useTranslations(current);
// The 404 page has no counterpart in other languages, so it links to their home pages.
const path =
  Astro.routePattern === "/404"
    ? "/"
    : pathWithoutLocale(Astro.url.pathname, current);
---

<details data-language-picker class="group relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-2 rounded border border-border/40 bg-bg-dark px-3 py-1.5 text-sm text-text transition-colors hover:border-border [&::-webkit-details-marker]:hidden"
  >
    <span class="sr-only">{t("langPicker.label")}:</span>
    {languages[current]}
    <svg
      aria-hidden="true"
      viewBox="0 0 16 16"
      class="size-3 text-disabled transition-transform group-open:rotate-180"
    >
      <path
        d="M4 6l4 4 4-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>

  <ul
    class="absolute right-0 top-full z-10 mt-2 min-w-36 rounded border border-border/40 bg-bg-dark-secondary p-1 shadow-lg shadow-black/40 group-open:animate-fade-in"
  >
    {
      Object.entries(languages).map(([code, name]) => (
        <li>
          <a
            href={getRelativeLocaleUrl(code, path)}
            hreflang={code}
            lang={code}
            aria-current={code === current ? "page" : undefined}
            class:list={[
              "block rounded-xs px-3 py-2 text-sm transition-colors hover:bg-bg-dark hover:text-text",
              code === current ? "text-text" : "text-disabled",
            ]}
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>("[data-language-picker]")
    .forEach((picker) => {
      document.addEventListener("click", (event) => {
        if (!picker.contains(event.target as Node)) picker.open = false;
      });

      picker.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !picker.open) return;
        picker.open = false;
        picker.querySelector("summary")?.focus();
      });
    });
</script>
