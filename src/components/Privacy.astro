---
import { defaultLang, useTranslations, type UIKey } from "../i18n/utils";
import { links } from "../links";

const t = useTranslations(Astro.currentLocale ?? defaultLang);

type Block =
  | { type: "text"; text: UIKey }
  | { type: "list"; items: UIKey[] }
  | { type: "terms"; items: { term: UIKey; text: UIKey }[] }
  | { type: "email"; text: UIKey };

const sections: { title: UIKey; blocks: Block[] }[] = [
  {
    title: "privacy.stored.title",
    blocks: [
      { type: "text", text: "privacy.stored.intro" },
      {
        type: "list",
        items: [
          "privacy.stored.routines",
          "privacy.stored.workouts",
          "privacy.stored.bodyWeight",
          "privacy.stored.profile",
          "privacy.stored.preferences",
          "privacy.stored.notifications",
        ],
      },
      { type: "text", text: "privacy.stored.storage" },
    ],
  },
  {
    title: "privacy.notDone.title",
    blocks: [
      {
        type: "list",
        items: [
          "privacy.notDone.account",
          "privacy.notDone.internet",
          "privacy.notDone.analytics",
          "privacy.notDone.ads",
        ],
      },
    ],
  },
  {
    title: "privacy.permissions.title",
    blocks: [
      {
        type: "terms",
        items: [
          {
            term: "privacy.permissions.notificationsLabel",
            text: "privacy.permissions.notificationsText",
          },
          {
            term: "privacy.permissions.startupLabel",
            text: "privacy.permissions.startupText",
          },
        ],
      },
    ],
  },
  {
    title: "privacy.backups.title",
    blocks: [
      { type: "text", text: "privacy.backups.system" },
      { type: "text", text: "privacy.backups.export" },
    ],
  },
  {
    title: "privacy.deleting.title",
    blocks: [{ type: "text", text: "privacy.deleting.text" }],
  },
  {
    title: "privacy.images.title",
    blocks: [{ type: "text", text: "privacy.images.text" }],
  },
  {
    title: "privacy.website.title",
    blocks: [{ type: "text", text: "privacy.website.text" }],
  },
  {
    title: "privacy.changes.title",
    blocks: [{ type: "text", text: "privacy.changes.text" }],
  },
  {
    title: "privacy.contact.title",
    blocks: [{ type: "email", text: "privacy.contact.text" }],
  },
];

const email = links.contact.replace("mailto:", "");
---

<main class="mx-auto w-full max-w-page px-12 py-16 md:py-24">
  <article class="mx-auto flex max-w-2xl flex-col gap-14">
    <header class="flex flex-col gap-8">
      <h1 class="text-4xl leading-tight font-bold text-text md:text-5xl">
        {t("privacy.title")}
      </h1>
      <p class="text-[19px] text-disabled">{t("privacy.intro")}</p>
    </header>

    {
      sections.map(({ title, blocks }) => (
        <section class="flex flex-col gap-4 text-[17px] leading-relaxed text-disabled">
          <h2 class="font-mono text-[13px] tracking-[1px] text-accent uppercase">
            {t(title)}
          </h2>
          {blocks.map((block) => {
            if (block.type === "text") return <p>{t(block.text)}</p>;
            if (block.type === "list")
              return (
                <ul class="flex list-disc flex-col gap-2 pl-5">
                  {block.items.map((item) => (
                    <li class="pl-1">{t(item)}</li>
                  ))}
                </ul>
              );
            if (block.type === "terms")
              return (
                <ul class="flex list-disc flex-col gap-2 pl-5">
                  {block.items.map(({ term, text }) => (
                    <li class="pl-1">
                      <strong class="text-text">{t(term)}</strong> {t(text)}
                    </li>
                  ))}
                </ul>
              );
            return (
              <p>
                {t(block.text)}{" "}
                <a
                  href={links.contact}
                  class="text-accent underline-offset-4 hover:underline"
                >
                  {email}
                </a>
              </p>
            );
          })}
        </section>
      ))
    }

    <p
      class="border-t border-border/40 pt-6 font-mono text-[13px] text-disabled"
    >
      {t("privacy.updated")}
    </p>
  </article>
</main>
