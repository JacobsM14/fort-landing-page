---
import { Font } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import Header from "../components/Header.astro";
import {
  defaultLang,
  languages,
  pathWithoutLocale,
  useTranslations,
} from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { title = t("meta.title"), description = t("meta.description") } =
  Astro.props;

const path = pathWithoutLocale(Astro.url.pathname, lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      Astro.site && (
        <>
          <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
          {Object.keys(languages).map((code) => (
            <link
              rel="alternate"
              hreflang={code}
              href={getAbsoluteLocaleUrl(code, path)}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={getAbsoluteLocaleUrl(defaultLang, path)}
          />
        </>
      )
    }
  </head>
  <body class="min-h-screen bg-bg-dark font-sans">
    <Header />
    <slot />
  </body>
</html>
