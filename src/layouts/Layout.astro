---
import { Font } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import logo from "../assets/logo.svg";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import {
  defaultLang,
  getLang,
  languages,
  ogLocales,
  pathWithoutLocale,
  useTranslations,
  type Lang,
} from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title = t("meta.title"), description = t("meta.description") } =
  Astro.props;

const path = pathWithoutLocale(Astro.url.pathname, lang);
// The 404 page answers every missing URL, so it has no address of its own to point to.
const isNotFound = Astro.routePattern === "/404";
const canonical =
  Astro.site && !isNotFound
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;
const ogImage = Astro.site && new URL(`/og/${lang}.png`, Astro.site);
const otherLangs = (Object.keys(languages) as Lang[]).filter(
  (code) => code !== lang,
);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Same color as --color-bg-dark in global.css -->
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <script
      defer
      src="https://analytics.arcedo.dev/script.js"
      data-website-id="1d38076f-5712-41e9-8b00-59e3bf4e2d50"
    ></script>
    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        {Object.keys(languages).map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={getAbsoluteLocaleUrl(code, path)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={getAbsoluteLocaleUrl(defaultLang, path)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("app.name")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t("meta.ogImageAlt")} />
      </>
    )}
    <meta property="og:locale" content={ogLocales[lang]} />
    {otherLangs.map((code) => (
      <meta property="og:locale:alternate" content={ogLocales[code]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen bg-bg-dark font-sans">
    <Header />
    <div class="overflow-x-clip">
      <slot />
    </div>
    <Footer />
  </body>
</html>
